{
  // Workspace configuration for hotsauce-cms monorepo
  "name": "@hotsauce/workspace",
  "version": "0.1.12",
  "exports": "./packages/core/mod.ts",

  // Use local node_modules for npm packages (enables fine-grained permissions)
  "nodeModulesDir": "auto",

  // Monorepo packages
  "workspace": [
    "./packages/core",
    "./packages/ui",
    "./packages/auth",
    "./packages/cms",
    "./packages/workers",
    "./packages/plugins",

    // Apps (full applications)
    "./apps/demo",
    "./apps/www"
  ],

  // Shared import map for all packages
  "imports": {
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "drizzle-orm": "npm:drizzle-orm@^0.45.4",
    "drizzle-zod": "npm:drizzle-zod@^0.8.3",
    "postgres": "npm:postgres@^3.4.8",
    "zod": "npm:zod@^4.3.6",

    // Local packages (for cross-package imports)
    "@hotsauce/core": "./packages/core/mod.ts",
    "@hotsauce/core/extend": "./packages/core/extend/mod.ts",
    "@hotsauce/ui": "./packages/ui/mod.ts",
    "@hotsauce/auth": "./packages/auth/mod.ts",
    "@hotsauce/cms": "./packages/cms/mod.ts",
    "@hotsauce/workers": "./packages/workers/mod.ts",
    "@hotsauce/plugins": "./packages/plugins/mod.ts",
    "@hotsauce/plugins/audit-log": "./packages/plugins/audit-log/mod.ts",
    "@hotsauce/plugins/audit-log/worker": "./packages/plugins/audit-log/worker.ts",
    "@hotsauce/plugins/puck": "./packages/plugins/puck/mod.ts",
    "@hotsauce/plugins/puck/types": "./packages/plugins/puck/types.ts",
    "@hotsauce/plugins/s3-storage": "./packages/plugins/s3-storage/mod.ts",
    "@hotsauce/plugins/fs-storage": "./packages/plugins/fs-storage/mod.ts",

    // Optional peer dependency for 2FA QR code generation
    "qrcode-generator": "npm:qrcode-generator@^2.0.4",

    // Dev dependencies (not shipped to users)
    "@std/assert": "jsr:@std/assert@1.0.18",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@^0.3.15",
    "sql.js": "npm:sql.js@^1.13.0"
  },

  // Tasks
  "tasks": {
    // Testing tasks with fine-grained permissions
    "test": "deno test -P --parallel",
    "test:debug": "deno test -P", // sequential for debugging
    "test:watch": "deno test -P --watch",
    "test:drizzle-compat": "deno test -P packages/core/tests/drizzle_compat_test.ts",
    "test:npm": "./scripts/npm/test-npm.sh", // builds + tests in Docker
    // Benchmarks (see BENCHMARKS.md)
    "bench": "deno bench -P",
    "bench:json": "deno bench -P --json",
    // Code quality tasks
    "check": "deno check packages/*/mod.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "hooks:run": "deno fmt --check && deno lint && deno task check",
    // JRS
    "update-jsr-paths": "deno run --allow-read=deno.jsonc --allow-write=deno.jsonc scripts/jsr/update_jsr_paths.ts",
    "update-package-versions": "deno run --allow-read=packages,deno.jsonc --allow-write=packages,deno.jsonc scripts/jsr/update_package_versions.ts",
    // Example-specific tasks
    "example:seed": "deno task -f example-deno-server seed",
    "example:dev": "deno task -f example-deno-server dev",
    "example:dev:watch": "deno task -f example-deno-server dev:watch",
    "example:dev:debug": "deno task -f example-deno-server dev:debug",
    "demo:seed": "deno task -f demo-app seed",
    "demo:dev": "deno task -f demo-app dev",
    "demo:dev:watch": "deno task -f demo-app dev:watch",
    "demo:dev:debug": "deno task -f demo-app dev:debug",
    "demo:build:components": "deno task -f demo-app build:components",
    "www:seed": "deno task -f www seed",
    "www:dev": "deno task -f www dev",
    "www:dev:watch": "deno task -f www dev:watch",
    "puck:build": "deno task -f @hotsauce/plugins build:puck"
  },

  // Test configuration with fine-grained permissions
  "test": {
    "include": ["packages/*/tests/"],
    "permissions": {
      "read": [
        "./packages",
        "./node_modules/.deno/@electric-sql+pglite@0.3.15/node_modules/@electric-sql/pglite/dist/pglite.data",
        "./node_modules/.deno/@electric-sql+pglite@0.3.15/node_modules/@electric-sql/pglite/dist/pglite.wasm",
        "./node_modules/.deno/sql.js@1.13.0/node_modules/sql.js/dist/sql-wasm.wasm"
      ],
      // The fs-storage disk-adapter tests exercise real disk I/O against
      // uniquely-named temp dirs created under this single, scoped directory.
      "write": [
        "./packages/plugins/fs-storage/tests/.tmp"
      ],
      "env": [
        "CMS_2FA_SECRET",
        "CMS_CSRF_SECRET",
        "CMS_JWT_SECRET",
        "CMS_TESTING"
      ]
    }
  },

  // Benchmark configuration with fine-grained permissions.
  // E2E handler benches use in-memory node:sqlite, so no wasm/db file reads.
  "bench": {
    "include": ["packages/*/benches/"],
    "permissions": {
      "read": ["./packages"],
      "env": [
        "CMS_CSRF_SECRET",
        "CMS_JWT_SECRET",
        "CMS_TESTING"
      ]
    }
  },

  // Compiler options
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true
  },

  // Formatting
  "fmt": {
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve",
    "exclude": [
      // AUTO-GENERATED bundles (written by packages/plugins/puck/build.ts) —
      // regenerating them shouldn't require a format pass to keep CI green
      "packages/plugins/puck/bundle-embedded.ts",
      "packages/plugins/puck/css-embedded.ts"
    ]
  },

  // Linting
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["no-console"]
    }
  },

  // Exclude build artifacts
  "exclude": [
    "npm/",
    "coverage/",
    ".git/",
    "scripts/",
    // Node/tsx sub-project (sandcastle agent workflows) — not Deno code
    ".sandcastle/",
    // Claude Code worktrees/config — nested checkouts otherwise re-enter the
    // graph with paths the root-relative excludes above don't match
    ".claude/"
  ]
}
